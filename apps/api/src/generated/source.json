{
  "openapi": "3.0.0",
  "info": {
    "title": "Календарь звонков",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/api/event-types": {
      "get": {
        "operationId": "listEventTypes",
        "description": "Все EventType по возрастанию времени создания.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventType"
                  }
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEventType",
        "description": "Создаёт EventType и возвращает его с назначенным id (нужен для подсветки в списке Owner).",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventType"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEventType"
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "description": "Проверка живости: используется smoke-тестом и Docker HEALTHCHECK.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/owner": {
      "get": {
        "operationId": "getOwner",
        "description": "Имя и часовой пояс Owner.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Owner"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Описание для разработчика; пользователю UI показывает свой текст по `code`."
          }
        },
        "description": "Единая модель ошибки API."
      },
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "INTERNAL_ERROR"
        ],
        "description": "Машиночитаемая причина ошибки: клиент различает отказы по ней, а не по тексту."
      },
      "EventType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "durationMinutes",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Системный id (UUID): его назначает сервер."
          },
          "name": {
            "type": "string",
            "description": "Название; не уникально."
          },
          "description": {
            "type": "string",
            "description": "Необязательное описание; без описания поле отсутствует."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "description": "Длительность звонка в минутах."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Момент создания: по нему упорядочен список типов."
          }
        },
        "description": "EventType — вид звонка, который публикует Owner; Guest бронирует время в его рамках."
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "description": "Ответ проверки живости."
      },
      "NewEventType": {
        "type": "object",
        "required": [
          "name",
          "durationMinutes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Название; не уникально. Сервер обрезает пробелы по краям, название из одних пробелов — пустое."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Необязательное описание; пустое после обрезки пробелов означает «нет описания»."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 15,
            "maximum": 540,
            "description": "Длительность звонка в минутах, кратная 15: кратность контракт выразить не может, её проверяет сервер."
          }
        },
        "description": "Данные нового EventType; id и момент создания назначает сервер."
      },
      "Owner": {
        "type": "object",
        "required": [
          "name",
          "timezone"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Имя, которое видит Guest на публичной странице."
          },
          "timezone": {
            "type": "string",
            "description": "IANA-пояс Owner (например, `Europe/Moscow`): в нём считается и показывается время."
          }
        },
        "description": "Owner — владелец календаря; задаётся конфигурацией сервера."
      }
    }
  }
}