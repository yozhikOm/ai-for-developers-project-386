# Порт, на котором слушает backend (и в prod-режиме раздаёт статику frontend)
PORT=3000

# Owner — владелец календаря (конфигурация сервера, а не запись в БД).
# Имя на публичной странице; по умолчанию «Владелец календаря»
OWNER_NAME=Владелец календаря
# IANA-пояс, в котором считается и показывается время; по умолчанию Europe/Moscow
OWNER_TIMEZONE=Europe/Moscow
